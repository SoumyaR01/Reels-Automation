# ReelForge Movie RAG System Configuration

# Paths
REELFORGE_WORK_DIR=workdir
REELFORGE_OUTPUT_DIR=reels
REELFORGE_DEFAULT_MOVIE=Heart.of.the.Beast.2026.1080p.AMZN.WEB-DL.DUAL.DDP5.1.H.264-Vegamovies.tw.mkv

# Ingest and Video Encoding
REELFORGE_REEL_WIDTH=1080
REELFORGE_REEL_HEIGHT=1920
REELFORGE_CRF=20
REELFORGE_PRESET=medium
REELFORGE_PROXY_HEIGHT=360
REELFORGE_PROXY_FPS=12.0

# Audio Standards
REELFORGE_AUDIO_SAMPLE_RATE=16000
REELFORGE_TARGET_LOUDNESSS_LUFS=-14.0

# Rights & Compliance
REELFORGE_ENFORCE_RIGHTS_GATE=false
REELFORGE_AI_DISCLOSURE_LABEL=true

# Optional API Keys for External LLMs (OpenAI/Anthropic/Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=
